<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>LSBUD Member Portal</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: "Segoe UI", Arial, sans-serif;
    background: #f4f6f9;
}

/* Header */

.header {
    background: #003366;
    color: white;
    padding: 18px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 24px;
    font-weight: 600;
}

.version {
    font-size: 13px;
    opacity: 0.8;
}

/* Login */

.login-container {
    max-width: 450px;
    margin: 60px auto;
    background: white;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
}

.login-container h1 {
    color: #003366;
    margin-bottom: 20px;
}

label {
    display: block;
    margin-top: 15px;
    margin-bottom: 6px;
    font-weight: 600;
}

input {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
}

.btn {
    width: 100%;
    padding: 14px;
    margin-top: 20px;
    border: none;
    border-radius: 6px;
    background: #009639;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

.btn:hover {
    background: #007b2f;
}

.hidden {
    display: none;
}

/* Dashboard */

.dashboard {
    display: none;
}

.dashboard-layout {
    display: flex;
    height: calc(100vh - 60px);
}

.sidebar {
    width: 240px;
    background: #002147;
    color: white;
    padding-top: 20px;
}

.sidebar ul {
    list-style: none;
}

.sidebar li {
    padding: 15px 25px;
    cursor: pointer;
    border-left: 3px solid transparent;
}

.sidebar li:hover {
    background: #003366;
    border-left: 3px solid #00b140;
}

.main-content {
    flex: 1;
    padding: 25px;
    overflow-y: auto;
}

.card {
    background: white;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.card h2 {
    color: #003366;
    margin-bottom: 10px;
}

/* Stats */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
    gap: 20px;
    margin-bottom: 20px;
}

.stat-card {
    background: white;
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    text-align: center;
}

.stat-card h3 {
    color: #003366;
    margin-bottom: 10px;
}

.stat-number {
    font-size: 36px;
    color: #009639;
    font-weight: bold;
}

/* Elastic Placeholder */

.elastic-placeholder {
    height: 600px;
    border: 2px dashed #cfd8dc;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #fafafa;
    text-align: center;
}

.elastic-placeholder h3 {
    color: #003366;
    margin-bottom: 10px;
}

.elastic-placeholder p {
    max-width: 500px;
    color: #666;
    line-height: 1.6;
}

.badge {
    display: inline-block;
    background: #009639;
    color: white;
    padding: 6px 12px;
    border-radius: 30px;
    margin-top: 15px;
}

/* Mobile */

@media(max-width: 768px){

    .dashboard-layout{
        flex-direction: column;
    }

    .sidebar{
        width:100%;
    }

}

</style>
</head>

<body>

<!-- HEADER -->

<div class="header">
    <div class="logo">LSBUD Member Portal</div>
    <div class="version">Proof of Concept v1.0</div>
</div>

<!-- LOGIN -->

<div class="login-container" id="loginScreen">

    <h1>Member Login</h1>

    <label>Email Address</label>
    <input type="email" placeholder="name@company.co.uk">

    <label>Password</label>
    <input type="password" placeholder="Enter your password">

    <button class="btn" onclick="showMFA()">
        Continue
    </button>

</div>

<!-- MFA -->

<div class="login-container hidden" id="mfaScreen">

    <h1>Two-Factor Authentication</h1>

    <p>
        Enter the 6-digit verification code from your authenticator app.
    </p>

    <label>Verification Code</label>
    <input id="mfaCode" type="text" maxlength="6" placeholder="123456">

    <button class="btn" onclick="loginPortal()">
        Verify
    </button>

</div>

<!-- DASHBOARD -->

<div class="dashboard" id="dashboard">

<div class="dashboard-layout">

<div class="sidebar">

    <ul>
        <li>Dashboard</li>
        <li>Asset Activity</li>
        <li>Excavation Alerts</li>
        <li>Usage Reports</li>
        <li>Notifications</li>
        <li>Users</li>
        <li>Settings</li>
        <li>Support</li>
    </ul>

</div>

<div class="main-content">

    <div class="card">

        <h2>Welcome</h2>

        <p>
            The LSBUD Member Portal provides visibility of activity around
            your assets, operational insights and future integrations such as
            NUAR and member analytics.
        </p>

    </div>

    <div class="stats-grid">

        <div class="stat-card">
            <h3>Searches Today</h3>
            <div class="stat-number">2,381</div>
        </div>

        <div class="stat-card">
            <h3>Excavation Alerts</h3>
            <div class="stat-number">156</div>
        </div>

        <div class="stat-card">
            <h3>Active Users</h3>
            <div class="stat-number">74</div>
        </div>

        <div class="stat-card">
            <h3>Members Online</h3>
            <div class="stat-number">21</div>
        </div>

    </div>

    <div class="card">

        <h2>Elastic Activity Dashboard</h2>

        <div class="elastic-placeholder">

            <h3>Elastic / Kibana Dashboard</h3>

            <p>
                This area will contain the embedded Elastic dashboard showing
                excavation activity, searches, notifications, alerts and
                operational metrics relating to member assets.
            </p>

            <div class="badge">
                Ready for Kibana Integration
            </div>

        </div>

    </div>

</div>

</div>

</div>

<script>

function showMFA() {

    document.getElementById("loginScreen").classList.add("hidden");
    document.getElementById("mfaScreen").classList.remove("hidden");

}

function loginPortal() {

    const code = document.getElementById("mfaCode").value;

    if (code === "123456") {

        document.getElementById("mfaScreen").classList.add("hidden");
        document.getElementById("dashboard").style.display = "block";

    } else {

        alert("Invalid verification code. Use 123456 for the demo.");

    }

}

</script>

</body>
</html>
